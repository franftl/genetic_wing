# Entorno virtual de Python -- NO se comparte, se recrea con:
#   python -m venv .venv
#   pip install -r requirements.txt
# Es la causa principal de que subir la carpeta tarde horas: son miles de
# archivos chicos de paquetes instalados, no código del proyecto.
.venv/
venv/
env/

# Cache de Python
__pycache__/
*.pyc
*.pyo

# Checkpoints de Jupyter
.ipynb_checkpoints/

# Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de prueba de CAD/CFD (geometría exportada para Ansys/Fusion; se regeneran)
*.stl
*.step
*.stp

# Checkpoints de corridas locales (los vigentes están en resultados/)
resultados/cfd_*/*.stl
# Salidas de correr el notebook 02 (se regeneran en cada corrida)
checkpoint_avion_*.json
avion_design_params_*.json

# Vistas 3D de la comparación con viento (~11 MB, se regeneran con
# python viento/optimizar_con_viento.py --solo-comparar)
viento/resultados/vistas_3d/
