clc
clear

% Constantes
Cd_Banner = 0.364;
S_Banner = 1/5 * (2)^2;
Cd_avion = 0.0165;
S_avion = 1.3;
ro = 1.225;
P_objetivo = 1200; % Watts
x=1277; %m
% Cálculo del área de resistencia total (S*Cd)
SCd_total = (S_avion * Cd_avion + S_Banner * Cd_Banner);

% Despeje de la velocidad v
v_ms = ( (2 * P_objetivo) / (ro * SCd_total) )^(1/3);

% Conversión a km/h para referencia
v_kmh = v_ms * 3.6;

% Mostrar resultados
fprintf('Para una potencia de %.2f W:\n', P_objetivo);
fprintf('La velocidad es: %.4f m/s\n', v_ms);
fprintf('En km/h es: %.4f km/h\n', v_kmh);


laps=min(5*60/(v_ms/x),100*60/P)
